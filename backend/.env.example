# Solo para uso local. Copia como backend/.env; nunca subas el archivo real.
PORT=3000
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST_NEON/sunarp_db?sslmode=require
DB_SSL=true
JWT_SECRET=REEMPLAZA_CON_UN_SECRET_ALEATORIO_DE_64_CARACTERES
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# NO activar contra production. El simulador puede escribir pagos de prueba.
SIMULADOR_PAGOS=false
# Solo cuando DATABASE_URL corresponda a una rama de desarrollo separada
DB_RAMA=produccion
